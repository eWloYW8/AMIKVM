{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMIKVM",
  "version": "0.2.0",
  "identifier": "io.amikvm.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "windows": { "staticVCRuntime": false }
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "AMIKVM",
      "width": 1280,
      "height": 840,
      "minWidth": 900,
      "minHeight": 600,
      "backgroundColor": "#101416"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
